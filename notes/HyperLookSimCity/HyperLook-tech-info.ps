} def
/TL {	% text w h lh --
	5 dict begin /h exch def 0 exch moveto pop
	{gsave show grestore 0 h rmoveto} forall
	end
} def
/TR {	% text w h bh --
	5 dict begin /h exch def moveto 
	{ gsave dup stringwidth pop neg 0 rmoveto show 
	  grestore 0 h rmoveto} forall
